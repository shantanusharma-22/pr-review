{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/pr-review-agent/review-decision.schema.json",
  "title": "PR Review Decision",
  "description": "Structured output of one PR review. Produced by the model, validated by scripts/validate_findings.py, rendered by scripts/render_review.py, posted by scripts/post_review.py. Nothing in this object is ever posted without human approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pr",
    "verdict",
    "confidence",
    "summary",
    "changeSummary",
    "productReview",
    "findings",
    "securityReview",
    "testingReview",
    "rating",
    "risks",
    "praise",
    "questions",
    "inlineComments"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },

    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "repo", "number", "headSha", "baseRef", "headRef", "author", "authorAssociation"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 },
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "baseRef": { "type": "string" },
        "headRef": { "type": "string" },
        "author": { "type": "string" },
        "authorAssociation": {
          "type": "string",
          "enum": ["OWNER", "MEMBER", "COLLABORATOR", "CONTRIBUTOR", "FIRST_TIME_CONTRIBUTOR", "FIRST_TIMER", "NONE", "UNKNOWN"]
        }
      }
    },

    "verdict": {
      "type": "string",
      "description": "Maps to the GitHub review event. APPROVE = ready to merge; REQUEST_CHANGES = at least one P0/P1 finding or missing required proof; COMMENT = neutral / questions only.",
      "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT"]
    },

    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },

    "summary": {
      "type": "string",
      "description": "2-4 plain sentences: what the PR does, the verdict, and the one thing that matters most.",
      "minLength": 20
    },

    "changeSummary": {
      "type": "string",
      "description": "One neutral sentence describing what the PR changes, for a newcomer."
    },

    "productReview": {
      "type": "object",
      "description": "Decided BEFORE code review: should this change exist at all?",
      "additionalProperties": false,
      "required": ["worthIt", "userProblem", "rationale"],
      "properties": {
        "worthIt": { "type": "string", "enum": ["yes", "no", "needs_maintainer"] },
        "userProblem": { "type": "string", "description": "What the user sees, not what the code does." },
        "rationale": { "type": "string" }
      }
    },

    "findings": {
      "type": "array",
      "description": "Discrete, actionable defects the author would fix. Each must name the trigger, the failing input, and the wrong result. Style and taste are NOT findings.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body", "priority", "category", "confidenceScore", "file", "lineStart", "lineEnd", "suggestion"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{1,3}$" },
          "title": { "type": "string", "maxLength": 120 },
          "body": { "type": "string", "description": "Trigger -> causal link -> failing input -> wrong result -> fix." },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"],
            "description": "P0 security/data-loss/outage; P1 incorrect behaviour on a real input; P2 defect with a workaround or missing upgrade proof; P3 real but low impact."
          },
          "category": {
            "type": "string",
            "enum": ["correctness", "security", "performance", "compatibility", "testing", "maintainability", "documentation", "process"]
          },
          "confidenceScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "file": { "type": "string" },
          "lineStart": { "type": "integer", "minimum": 1 },
          "lineEnd": { "type": "integer", "minimum": 1 },
          "suggestion": {
            "type": ["string", "null"],
            "description": "Replacement code for lines lineStart..lineEnd (becomes a ```suggestion block). null when no mechanical fix exists."
          }
        }
      }
    },

    "securityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "concerns"],
      "properties": {
        "status": { "type": "string", "enum": ["cleared", "needs_attention", "not_applicable"] },
        "summary": { "type": "string" },
        "concerns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "detail", "file", "line", "blocking"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["injection", "auth", "secrets", "supply_chain", "ci_workflow", "permissions", "data_exposure", "deserialization", "path_traversal", "other"]
              },
              "detail": { "type": "string" },
              "file": { "type": ["string", "null"] },
              "line": { "type": ["integer", "null"] },
              "blocking": { "type": "boolean" }
            }
          }
        }
      }
    },

    "testingReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofPath", "proofStatus", "missingE2e", "lowValueTests"],
      "properties": {
        "proofPath": {
          "type": "string",
          "enum": ["shipped_entry_point", "in_process_harness", "unit_only", "none", "not_applicable"],
          "description": "Strongest evidence that the changed behaviour actually runs: real CLI/UI/API > harness > unit tests > nothing."
        },
        "proofStatus": { "type": "string", "enum": ["sufficient", "insufficient", "missing", "not_required"] },
        "missingE2e": { "type": "string", "description": "One sentence naming the untested scenario; empty when none." },
        "lowValueTests": { "type": "array", "items": { "type": "string" } }
      }
    },

    "rating": {
      "type": "object",
      "description": "Rates the evidence and the patch, never the person. Most PRs are B or C.",
      "additionalProperties": false,
      "required": ["proofTier", "patchTier", "overallTier", "rationale"],
      "properties": {
        "proofTier": { "type": "string", "enum": ["S", "A", "B", "C", "D", "F", "NA"] },
        "patchTier": { "type": "string", "enum": ["S", "A", "B", "C", "D", "F", "NA"] },
        "overallTier": { "type": "string", "enum": ["S", "A", "B", "C", "D", "F", "NA"] },
        "rationale": { "type": "string" }
      }
    },

    "risks": {
      "type": "array",
      "description": "Unresolved merge concerns NOT already stated as a finding or proof gap: upgrade, compatibility, operator impact.",
      "items": { "type": "string" }
    },

    "praise": { "type": "array", "items": { "type": "string" } },
    "questions": { "type": "array", "items": { "type": "string" } },

    "inlineComments": {
      "type": "array",
      "description": "Non-finding inline remarks (questions, nits worth placing on a line). Findings are rendered inline automatically; do not duplicate them here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "body"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "startLine": { "type": ["integer", "null"] },
          "side": { "type": "string", "enum": ["RIGHT", "LEFT"], "default": "RIGHT" },
          "body": { "type": "string" }
        }
      }
    }
  }
}
